<?xml version="1.0" encoding="UTF-8"?>
<resources>

    <fonts>
        <font id="ds_digital" filename="fonts/ds_digital/ds_digital.fnt" antialias="true"/>
        <font id="ds_digital_b" filename="fonts/ds_digital_b/ds_digital_b.fnt" antialias="true"/>
        <font id="ds_digital_i" filename="fonts/ds_digital_i/ds_digital_i.fnt" antialias="true"/>
        <font id="ds_digital_b_i" filename="fonts/ds_digital_b_i/ds_digital_b_i.fnt" antialias="true"/>
        <font id="ds_digital_b_i_s" filename="fonts/plus_petit/plus_petit.fnt" antialias="true"/>
        <font id="font_date" filename="fonts/date/date.fnt" antialias="true"/>
        <font id="font_weather" filename="fonts/weather-icon/weather-icon.fnt" antialias="true"/>

    </fonts>

    <properties>
        <property id="cadran" type="number">0</property>
        <property id="affichage" type="number">0</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.cadran" title="@Strings.cadran" prompt="@Strings.cadran" >
            <settingConfig type="list">
                <listEntry value="0">@Strings.cadran_0</listEntry>
                <listEntry value="1">@Strings.cadran_1</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.affichage" title="@Strings.affichage" prompt="@Strings.affichage" >
            <settingConfig type="list">
                <listEntry value="0">@Strings.affichage_normal</listEntry>
                <listEntry value="1">@Strings.affichage_nuit</listEntry>
                <listEntry value="2">@Strings.affichage_auto</listEntry>
            </settingConfig>
        </setting>
    </settings>

</resources>
